{
  "name": "@deepseek-ai/dsh-doc-template",
  "description": "Function plugin rendering the shipped Chinese document templates: YAML front-matter templates with a typed variable schema, validated resolution reporting residual placeholders and warnings, Markdown/HTML/DOCX renderers, and the list_doc_templates and render_doc_template tools",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/document/doc-template"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "assets",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-doc-style": "workspace:*",
    "@deepseek-ai/dsh-docx-kit": "workspace:*",
    "@deepseek-ai/dsh-value": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "marked": "^16.4.2",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-fs": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-document-deliver": "workspace:*",
    "@deepseek-ai/dsh-fs": "workspace:*",
    "@deepseek-ai/dsh-fs-local": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/dsh-tool-testkit": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*"
  }
}
