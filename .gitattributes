# The repo's canonical text form is LF, enforced at checkout too: no smudge
# boundary between working tree and repo, so byte-level gates (verify-*
# comparisons, blob hashing, coverage offsets) see one form on every host.
# Windows command scripts require CRLF in the working tree for cmd.exe; the
# override after the default keeps the in-repo form normalized as text.
* text=auto eol=lf
*.cmd text eol=crlf

*.pdf binary

# STEP/IGES CAD fixtures are FreeCAD exporter output; ISO 10303-21 clear-text
# encoding leaves insignificant trailing whitespace the generator re-emits, so
# only the end-of-line check is disabled for the extension; end-of-file checks
# still apply.
*.step whitespace=-blank-at-eol
*.iges whitespace=-blank-at-eol

# The persistence catalog is the readable projection of these generated schemas.
docs/persistence-schema.json linguist-generated=true
docs/persistence-changes/*.schema.json linguist-generated=true
docs/persistence-changes/releases/*.schema.json linguist-generated=true
docs/persistence-changes/historical-formats/*.schema.json linguist-generated=true

# Unified patch blank context lines require their leading space.
patches/*.patch whitespace=-blank-at-eol

# Review layers of the forge changes view (dsh-review-layer), for this repository's own conventions:
# plugin locale dictionaries and the session snapshot tree hide with test files, generated bilingual
# pairing records join them, and a package's types-only module is part of its interface.
packages/*/*/locale/*.json dsh-review-layer=test
locales.ts dsh-review-layer=test
snapshots/** dsh-review-layer=test
*.i18n.yaml dsh-review-layer=test
packages/*/*/src/types.ts dsh-review-layer=interface
