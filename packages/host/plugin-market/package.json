{
  "name": "@deepseek-ai/dsh-host-plugin-market",
  "description": "Open plugin catalog seam (ctx.pluginCatalog): source registration, catalog search, and managed install/uninstall with snapshot/rollback receipts for the DeepSeek Harness",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/host/plugin-market"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./catalog": {
      "types": "./lib/types/catalog.d.ts",
      "default": "./lib/types/catalog.js"
    },
    "./install": {
      "types": "./lib/types/install.d.ts",
      "default": "./lib/types/install.js"
    },
    "./provider": {
      "types": "./lib/types/provider.d.ts",
      "default": "./lib/types/provider.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./restricted-fetch": {
      "types": "./lib/types/restricted-fetch.d.ts",
      "default": "./lib/types/restricted-fetch.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/schemastery": "workspace:~",
    "zod": "^4.4.3"
  }
}
