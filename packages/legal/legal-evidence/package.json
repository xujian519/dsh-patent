{
  "name": "@deepseek-ai/dsh-legal-evidence",
  "description": "Legal evidence triple-attribute assessment for the DeepSeek Harness: deterministic scoring of relevance, legality, and authenticity for the eight statutory evidence types under PRC Civil Procedure Law Art. 66, with the evaluate_legal_evidence tool",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/legal/legal-evidence"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "assets",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-tool-testkit": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*"
  }
}
