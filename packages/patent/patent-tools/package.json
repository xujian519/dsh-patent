{
  "name": "@deepseek-ai/dsh-patent-tools",
  "description": "Model-facing patent tool set for the DeepSeek Harness: search, metadata, legal status, case/wiki/kg knowledge queries, claim-chart, drafting, evidence judgment, rule check, and the workflow/plan tools, ported from Sati",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/patent/patent-tools"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/nuo-patent": "workspace:~",
    "@deepseek-ai/schemastery": "workspace:~",
    "@deepseek-ai/dsh-atomic-write": "workspace:*",
    "@deepseek-ai/dsh-browser-backend": "workspace:*",
    "@deepseek-ai/dsh-tool-literature": "workspace:*",
    "@deepseek-ai/dsh-util-values": "workspace:*",
    "@viz-js/viz": "^3.29.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-attachment": "workspace:*",
    "@deepseek-ai/dsh-jobs": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-patent-core": "workspace:*",
    "@deepseek-ai/dsh-patent-data": "workspace:*",
    "@deepseek-ai/dsh-patent-document": "workspace:*",
    "@deepseek-ai/dsh-patent-knowledge": "workspace:*",
    "@deepseek-ai/dsh-patent-rule": "workspace:*",
    "@deepseek-ai/dsh-patent-workflow": "workspace:*",
    "@deepseek-ai/dsh-subprocess": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-user-approval": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@deepseek-ai/dsh-attachment": "workspace:*",
    "@deepseek-ai/dsh-jobs": "workspace:*",
    "@deepseek-ai/dsh-jobs-local": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-patent-core": "workspace:*",
    "@deepseek-ai/dsh-patent-data": "workspace:*",
    "@deepseek-ai/dsh-patent-document": "workspace:*",
    "@deepseek-ai/dsh-patent-knowledge": "workspace:*",
    "@deepseek-ai/dsh-patent-rule": "workspace:*",
    "@deepseek-ai/dsh-patent-workflow": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-subprocess": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/dsh-tool-jobs": "workspace:*",
    "@deepseek-ai/dsh-tool-testkit": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-user-approval": "workspace:*"
  }
}
